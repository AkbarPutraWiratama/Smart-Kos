APP_NAME="Smart Kos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_HOST: local = 127.0.0.1 | docker = mysql
# DB_USERNAME: local = root (or your local mysql user) | docker = sail
# DB_PASSWORD: local = your local mysql password | docker = SmartKos-Local
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smart-kos
DB_USERNAME=sail
DB_PASSWORD=SmartKos-Local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# No change needed. Run "php artisan storage:link" once if running locally.
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_HOST: local = 127.0.0.1 | docker = redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER: local = log | docker = smtp
# MAIL_HOST: local = 127.0.0.1 | docker = mailpit
# MAIL_PORT: local = 2525 | docker = 1025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

SMARTKOS_BANK_1_NAME=
SMARTKOS_BANK_1_NUMBER=
SMARTKOS_BANK_1_HOLDER=

SMARTKOS_BANK_2_NAME=
SMARTKOS_BANK_2_NUMBER=
SMARTKOS_BANK_2_HOLDER=

SMARTKOS_BANK_3_NAME=
SMARTKOS_BANK_3_NUMBER=
SMARTKOS_BANK_3_HOLDER=

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8026
FORWARD_PHPMYADMIN_PORT=8080
VITE_PORT=5173
MYSQL_EXTRA_OPTIONS=

WWWUSER=1000
WWWGROUP=1000
